PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern-voting
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Admin account created automatically on first start
ADMIN_NAME=Election Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Email (OTP). Leave SMTP_HOST empty to print OTP codes in this terminal instead (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ballot <no-reply@example.com>"
